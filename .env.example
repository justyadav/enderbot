# Example environment variables for the bot
# Copy to .env and fill in values before running: cp .env.example .env

# Discord bot token
DISCORD_TOKEN=your_token_here
# Optional: application id (for command registration)
APPLICATION_ID=
# Command prefix for legacy prefix commands (slash commands are recommended)
PREFIX=!

# Bot identity / status
BOT_NAME=Ender Bot
DEVELOPER_NAME=YADUVANSHI1816_
CUSTOM_STATUS=Developed by YADUVANSHI1816_ | /help

# Postgres DB (recommended for production)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ender_db

# Redis for cache/queues
REDIS_URL=redis://localhost:6379/0

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Optional: shard settings for horizontal scaling
SHARD_START=0
SHARD_END=0
TOTAL_SHARDS=1
